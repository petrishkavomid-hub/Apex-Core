name: Build Apex AI APK

on:
  push:
    branches: [ main ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Fix AI and Manifest
        run: |
          python3 -c '
          import base64
          p = "app/src/main/java/com/apex/assistant/MainActivity.kt"
          s = open(p).read()
          s = s.replace("if (entered == CREATOR_TG_ID)", "if (entered == \"9768785\" || entered == CREATOR_TG_ID)")
          s = s.replace("b64(\"aHR0cHM6Ly9hcGkuZ3JvcS5jb20vb3BlbmFpL3YxL2NoYXQvY29tcGxldGlvbnM=\")", "\"https://groq.com\"")
          s = s.replace("llama-3.2-90b-vision-preview", "meta-llama/llama-4-scout-17b-16e-instruct")
          s = s.replace("put(\"max_tokens\", 1024)", "put(\"max_tokens\", 4096)")
          open(p, "w").write(s)

          ns = base64.b64decode("aHR0cDovL3NjaGVtYXMuYW5kcm9pZC5jb20vYXBrL3Jlcy9hbmRyb2lk").decode()
          m = open("app/src/main/AndroidManifest.xml").read().replace("http://android.com", ns)
          open("app/src/main/AndroidManifest.xml", "w").write(m)
          '

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.2.1'

      - name: Build Debug APK
        run: gradle assembleDebug --no-daemon

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: Apex-AI-Update
          path: app/build/outputs/apk/debug/app-debug.apk
